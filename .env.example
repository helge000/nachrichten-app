# Domain, unter der die App laeuft.
# "localhost" fuer den lokalen Test (Caddy nutzt seine interne CA),
# sonst die echte Domain - Caddy holt dann automatisch ein Zertifikat.
SITE_ADDRESS=localhost

# Wo die synchronisierten Einstellungen liegen.
# Fuer die Entwicklung reicht der Standard ./user_data.
# In Produktion besser ausserhalb des Arbeitsbaums - ein "git clean -xdf"
# loescht ignorierte Verzeichnisse im Baum mitsamt Inhalt:
#   DATA_DIR=/srv/nachrichten-data
DATA_DIR=./user_data

# Benutzer, dem die Dateien gehoeren sollen (Ausgabe von "id -u" / "id -g").
# Muss zum Eigentuemer von DATA_DIR passen, sonst kann der Container nicht
# schreiben.
PUID=1000
PGID=1000

# Stimme der Ansage. Bleibt die Zeile auskommentiert, gilt die Standardstimme
# aus dem Dockerfile: kerstin, weiblich, 16 kHz.
#
# ACHTUNG: auskommentieren, nicht leer lassen. "VOICE_URL=" ohne Wert reicht
# einen Leerstring durch und laesst den Bau scheitern.
#
# Alle Modelle: https://github.com/k2-fsa/sherpa-onnx/releases/tag/tts-models
# Fuer Deutsch naheliegend (Basis-URL wie unten, nur der letzte Teil wechselt):
#   vits-piper-de_DE-kerstin-low     weiblich, Standard
#   vits-piper-de_DE-ramona-low      weiblich, rund 5 dB leiser als die Folgen
#   vits-piper-de_DE-eva_k-x_low     weiblich, kleineres Modell (20 MB)
#   vits-piper-de_DE-thorsten-medium maennlich, 22 kHz
#
# Nach einer Aenderung neu bauen:  docker compose build app && docker compose up -d
#VOICE_URL=https://github.com/k2-fsa/sherpa-onnx/releases/download/tts-models/vits-piper-de_DE-ramona-low.tar.bz2
